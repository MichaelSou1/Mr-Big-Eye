# =============================================================================
# VLM API (multimodal Q&A and captioning)
# =============================================================================
# Two wire formats are supported. Pick the one that matches your provider:
#
#   responses          -> Volcano Ark / Doubao "Responses" API
#                         POST {VLM_API_BASE_URL}/responses
#   chat_completions   -> OpenAI-compatible Chat Completions
#                         POST {VLM_API_BASE_URL}/chat/completions
#                         (Xiaomi MiMo and most OpenAI-compatible providers)
#
# Doubao (Volcano Ark) example:
#   VLM_API_PROVIDER=doubao
#   VLM_API_FORMAT=responses
#   VLM_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   VLM_API_KEY=<ARK_API_KEY>
#   VLM_MODEL_NAME=doubao-seed-2-0-pro-260215
#
# Xiaomi MiMo example:
#   VLM_API_PROVIDER=mimo
#   VLM_API_FORMAT=chat_completions
#   VLM_API_BASE_URL=https://api.xiaomimimo.com/v1
#   VLM_API_KEY=<MIMO_API_KEY>
#   VLM_MODEL_NAME=mimo-vl-7b-rl
VLM_API_PROVIDER=doubao
VLM_API_FORMAT=responses
VLM_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VLM_API_KEY=
VLM_MODEL_NAME=doubao-seed-2-0-pro-260215
VLM_API_TIMEOUT=120

# Tool-aware text orchestrator. Defaults to VLM_API_* when left blank.
# This endpoint must support OpenAI-compatible Chat Completions tool calls.
ORCHESTRATOR_API_BASE_URL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL_NAME=
ORCHESTRATOR_API_TIMEOUT=
ORCHESTRATOR_TEMPERATURE=0.2
ORCHESTRATOR_MAX_TOOL_CALLS=8

# =============================================================================
# App
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_VIDEO_DURATION_SEC=600
MAX_UPLOAD_SIZE_MB=2048
LOAD_MODELS_ON_STARTUP=false
UNLOAD_MODELS_AFTER_USE=true
APP_CUDA_VISIBLE_DEVICES=
SESSION_TITLE_MAX_CHARS=48

# =============================================================================
# Retrieval encoders (still local, not VLMs)
# =============================================================================
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_LOCAL_DIR=./models/bge-m3
SIGLIP2_MODEL=google/siglip2-so400m-patch14-384
SIGLIP2_MODELSCOPE_MODEL=google/siglip2-so400m-patch14-384
SIGLIP2_LOCAL_DIR=./models/siglip2-so400m-patch14-384
SIGLIP2_DTYPE=float16
MODELS_DEVICE=cpu

# =============================================================================
# Retrieval / VQA tuning
# =============================================================================
TOP_N_SCENES=5
TOP_K_FRAMES=12
PLANNER_MAX_TOP_N_SCENES=12
PLANNER_MAX_TOP_K_FRAMES=36
VQA_MAX_FRAMES=6
VQA_MAX_IMAGE_SIDE=448
VQA_IMAGE_QUALITY=75
VQA_MAX_OUTPUT_TOKENS=1024
SCENE_DETECT_THRESHOLD=27.0
DENSE_FPS=1.0

# =============================================================================
# Storage
# =============================================================================
DATA_DIR=./data
DATABASE_PATH=
GRAPH_CHECKPOINT_PATH=
LANGMEM_STORE_PATH=

# =============================================================================
# LangMem (text-only). Defaults to the VLM_API_* values above. Override these
# to route LangMem at a cheaper text-only model on the same provider.
# =============================================================================
LANGMEM_API_BASE_URL=
LANGMEM_API_KEY=
LANGMEM_MODEL_NAME=
LANGMEM_QUERY_LIMIT=6
PROGRESS_LANG=zh

# =============================================================================
# Eval LLM judge (text-only). Used by scripts/eval_harness.py --judge.
# If JUDGE_API_KEY is blank, falls back to VLM_API_* with a self-judging-bias
# warning (good enough for smoke tests; fill these in with a DIFFERENT model
# before publishing eval numbers).
# =============================================================================
JUDGE_API_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL_NAME=
JUDGE_API_TIMEOUT=120
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_OUTPUT_TOKENS=512

# =============================================================================
# HuggingFace
# HF_ENDPOINT: mirror for users without proxy access (downloads only). Defaults
#   to hf-mirror.com inside scripts when unset.
#   !! UPLOADS (pushing a model/adapter) DO NOT work through the mirror — set
#      HF_ENDPOINT=https://huggingface.co (needs proxy/direct access) to push.
# HF_TOKEN: paste a User Access Token from https://huggingface.co/settings/tokens.
#   - read token: for gated datasets like LongVideoBench (eval_prepare_datasets.py)
#   - WRITE token: required to upload the distilled adapter/model + reports to a
#     HF model repo (huggingface_hub.upload_folder / scripts upload helper).
# =============================================================================
HF_ENDPOINT=https://hf-mirror.com
HF_TOKEN=
# For model UPLOAD, override the mirror (uncomment, needs proxy):
# HF_ENDPOINT=https://huggingface.co
# HF_UPLOAD_REPO=MichaelSou1/mr-big-eye-orch-v2

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
