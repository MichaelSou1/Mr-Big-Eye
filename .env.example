# SGLang inference endpoint
SGLANG_ENDPOINT=http://127.0.0.1:30000
VLM_MODEL_NAME=Qwen/Qwen3-VL-2B-Instruct
VLM_MODEL_LOCAL_DIR=./models/Qwen3-VL-2B-Instruct
SGLANG_TIMEOUT=120
SGLANG_PORT=30000
SGLANG_TP_SIZE=1
SGLANG_MEM_FRACTION_STATIC=0.72
SGLANG_SERVED_MODEL_NAME=Qwen/Qwen3-VL-2B-Instruct
# Useful on WSL/laptops without nvcc; unset on servers for better throughput.
SGLANG_DISABLE_CUDA_GRAPH=false
SGLANG_ATTENTION_BACKEND=
SGLANG_DISABLE_OVERLAP_SCHEDULE=false

# App
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_VIDEO_DURATION_SEC=600
MAX_UPLOAD_SIZE_MB=2048
LOAD_MODELS_ON_STARTUP=true
UNLOAD_MODELS_AFTER_USE=false

# Models
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_LOCAL_DIR=./models/bge-m3
SIGLIP2_MODEL=google/siglip2-so400m-patch14-384
SIGLIP2_MODELSCOPE_MODEL=google/siglip2-so400m-patch14-384
SIGLIP2_LOCAL_DIR=./models/siglip2-so400m-patch14-384
SIGLIP2_DTYPE=auto
MODELS_DEVICE=cuda:0

# Retrieval
TOP_N_SCENES=5
TOP_K_FRAMES=12
VQA_MAX_FRAMES=6
VQA_MAX_IMAGE_SIDE=448
VQA_IMAGE_QUALITY=75
SCENE_DETECT_THRESHOLD=27.0
DENSE_FPS=1.0

# Storage
DATA_DIR=./data

# Logging
LOG_LEVEL=INFO
