# =============================================================================
# VLM API (multimodal Q&A and captioning)
# =============================================================================
# Server profile: prefer the larger / production-tier API model. Same two
# formats are supported; see .env.example for the full provider matrix.
VLM_API_PROVIDER=doubao
VLM_API_FORMAT=responses
VLM_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VLM_API_KEY=
VLM_MODEL_NAME=doubao-seed-2-0-pro-260215
VLM_API_TIMEOUT=120

# Tool-aware text orchestrator. Defaults to VLM_API_* when left blank.
# This endpoint must support OpenAI-compatible Chat Completions tool calls.
ORCHESTRATOR_API_BASE_URL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL_NAME=
ORCHESTRATOR_API_TIMEOUT=
ORCHESTRATOR_TEMPERATURE=0.2
ORCHESTRATOR_MAX_TOOL_CALLS=8

# =============================================================================
# App
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_VIDEO_DURATION_SEC=600
MAX_UPLOAD_SIZE_MB=2048
LOAD_MODELS_ON_STARTUP=true
UNLOAD_MODELS_AFTER_USE=false
APP_CUDA_VISIBLE_DEVICES=0
SESSION_TITLE_MAX_CHARS=48

# =============================================================================
# Retrieval encoders (still local, not VLMs)
# =============================================================================
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_LOCAL_DIR=./models/bge-m3
SIGLIP2_MODEL=google/siglip2-so400m-patch14-384
SIGLIP2_MODELSCOPE_MODEL=google/siglip2-so400m-patch14-384
SIGLIP2_LOCAL_DIR=./models/siglip2-so400m-patch14-384
SIGLIP2_DTYPE=auto
MODELS_DEVICE=cuda:0

# =============================================================================
# Retrieval / VQA tuning
# =============================================================================
TOP_N_SCENES=5
TOP_K_FRAMES=12
PLANNER_MAX_TOP_N_SCENES=12
PLANNER_MAX_TOP_K_FRAMES=36
VQA_MAX_FRAMES=12
VQA_MAX_IMAGE_SIDE=768
VQA_IMAGE_QUALITY=85
SCENE_DETECT_THRESHOLD=27.0
DENSE_FPS=1.0

# =============================================================================
# Storage
# =============================================================================
DATA_DIR=./data
DATABASE_PATH=
GRAPH_CHECKPOINT_PATH=
LANGMEM_STORE_PATH=

# =============================================================================
# LangMem (text-only). Defaults to the VLM_API_* values above.
# =============================================================================
LANGMEM_API_BASE_URL=
LANGMEM_API_KEY=
LANGMEM_MODEL_NAME=
LANGMEM_QUERY_LIMIT=8
PROGRESS_LANG=zh

# =============================================================================
# Eval LLM judge (text-only). Used by scripts/eval_harness.py --judge.
# If JUDGE_API_KEY is blank, falls back to VLM_API_* with a self-judging-bias
# warning. Fill in with a DIFFERENT model before publishing eval numbers.
# =============================================================================
JUDGE_API_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL_NAME=
JUDGE_API_TIMEOUT=120
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_OUTPUT_TOKENS=512

# =============================================================================
# HuggingFace (only needed by scripts/eval_prepare_datasets.py)
# HF_ENDPOINT: mirror for users without proxy access. Defaults to hf-mirror.com
#   inside the script when unset; override if you have direct HF access.
# HF_TOKEN: required for gated datasets like LongVideoBench. Accept the
#   license at https://huggingface.co/datasets/longvideobench/LongVideoBench
#   then paste a User Access Token from https://huggingface.co/settings/tokens.
#   Not needed for NExT-GQA (raw GitHub).
# =============================================================================
HF_ENDPOINT=https://hf-mirror.com
HF_TOKEN=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
